{
    "name": "neobr-ui-monorepo",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp run -r build",
        "test": "vp run -r test",
        "lint": "vp run -r lint",
        "format": "vp fmt .",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "vp run build && vp run test && changeset publish",
        "dev": "vp run --filter docs dev",
        "prepare": "vp config"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "vite-plus": "catalog:"
    },
    "packageManager": "pnpm@9.5.0",
    "engines": {
        "node": ">=20.19 || >=22"
    },
    "pnpm": {
        "overrides": {
            "cookie@<0.7.0": ">=0.7.0",
            "cookie": "^1.0.0",
            "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
            "lodash-es@>=4.0.0 <=4.17.23": ">=4.18.0",
            "lodash-es@<=4.17.23": ">=4.18.0",
            "vite@>=8.0.0 <=8.0.15": ">=8.0.16",
            "@sveltejs/kit@<=2.57.0": ">=2.57.1",
            "postcss@<8.5.23": ">=8.5.23"
        }
    }
}
