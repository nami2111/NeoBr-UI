{
    "name": "neobr-ui-monorepo",
    "private": true,
    "scripts": {
        "sync:css": "cp packages/svelte/src/lib/styles/design-system.css packages/tailwind-preset/design-system.css",
        "prebuild": "vp run sync:css",
        "build": "vp run -r build",
        "test": "vp run -r test",
        "lint": "vp run -r lint",
        "format": "vp fmt .",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "vp run build && vp run test && changeset publish",
        "dev": "vp run --filter docs dev",
        "prepare": "vp config"
    },
    "devDependencies": {
        "@changesets/cli": "^2.30.0",
        "vite-plus": "catalog:"
    },
    "packageManager": "pnpm@9.5.0",
    "engines": {
        "node": ">=18"
    }
}
