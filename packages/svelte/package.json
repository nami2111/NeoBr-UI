{
    "name": "@neobr/svelte",
    "version": "1.0.3",
    "type": "module",
    "description": "Premium Neo-Brutalist Svelte 5 Component Library",
    "repository": {
        "type": "git",
        "url": "https://github.com/nami2111/NeoBr-UI.git",
        "directory": "packages/svelte"
    },
    "homepage": "https://github.com/nami2111/NeoBr-UI/tree/main/packages/svelte#readme",
    "bugs": "https://github.com/nami2111/NeoBr-UI/issues",
    "license": "MIT",
    "keywords": [
        "svelte",
        "svelte5",
        "neo-brutalism",
        "ui-components",
        "component-library",
        "tailwind",
        "shadcn-svelte"
    ],
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "svelte-package",
        "dev": "vite dev",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./src/lib/index.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "peerDependencies": {
        "svelte": "^4.0.0 || ^5.0.0"
    },
    "devDependencies": {
        "@sveltejs/adapter-auto": "^3.0.0",
        "@sveltejs/kit": "2.50.2",
        "@sveltejs/package": "2.5.7",
        "@sveltejs/vite-plugin-svelte": "6.2.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.3.1",
        "jsdom": "^28.0.0",
        "svelte": "5.49.1",
        "svelte-check": "^4.3.6",
        "tslib": "^2.4.1",
        "typescript": "^5.0.0",
        "vite": "^7.3.1",
        "vitest": "^4.0.18",
        "vitest-axe": "^0.1.0",
        "vitest-dom": "^0.1.1"
    },
    "dependencies": {
        "@hugeicons/core-free-icons": "^3.1.1",
        "@hugeicons/svelte": "^1.1.0",
        "@neobr/tailwind-preset": "workspace:*",
        "bits-ui": "^2.15.5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.0",
        "tailwind-merge": "^2.2.0"
    }
}