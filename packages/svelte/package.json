{
    "name": "@neobr/svelte",
    "version": "2.0.1",
    "type": "module",
    "description": "Neo-Brutalist Svelte 5 Component Library",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nami2111/NeoBr-UI.git",
        "directory": "packages/svelte"
    },
    "homepage": "https://github.com/nami2111/NeoBr-UI/tree/main/packages/svelte#readme",
    "bugs": "https://github.com/nami2111/NeoBr-UI/issues",
    "license": "MIT",
    "keywords": [
        "svelte",
        "svelte5",
        "neo-brutalism",
        "ui-components",
        "component-library",
        "tailwind",
        "shadcn-svelte"
    ],
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "svelte-kit sync && svelte-package",
        "dev": "vp dev",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "vp fmt --check .",
        "format": "vp fmt .",
        "test": "vp test run",
        "test:watch": "vp test",
        "pack:check": "node scripts/check-package-files.mjs",
        "exports:check": "node scripts/check-package-exports.mjs",
        "tree-shake:check": "node scripts/check-tree-shaking.mjs"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./style": "./dist/styles/design-system.css",
        "./utils": {
            "types": "./dist/utils.d.ts",
            "svelte": "./dist/utils.js",
            "default": "./dist/utils.js"
        },
        "./*": {
            "types": "./dist/components/ui/*/index.d.ts",
            "svelte": "./dist/components/ui/*/index.js",
            "default": "./dist/components/ui/*/index.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*",
        "!dist/**/*test-wrapper*",
        "!dist/**/*test-helper*",
        "!dist/**/*-test.svelte*",
        "!dist/tests/**"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "peerDependencies": {
        "svelte": ">=5.40.0 <6"
    },
    "devDependencies": {
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/package": "2.5.8",
        "@sveltejs/vite-plugin-svelte": "7.2.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.4.2",
        "jsdom": "^28.1.0",
        "svelte": "5.56.8",
        "svelte-check": "^4.7.4",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:",
        "vitest-axe": "^0.1.0"
    },
    "dependencies": {
        "@hugeicons/core-free-icons": "^4.2.3",
        "@hugeicons/svelte": "^1.1.4",
        "@internationalized/date": "^3.12.3",
        "bits-ui": "^2.18.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3"
    }
}
