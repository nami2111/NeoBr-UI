{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "moduleResolution": "bundler",
        "module": "esnext",
        "target": "esnext",
        "paths": {
            "$lib": ["./src/lib"],
            "$lib/*": ["./src/lib/*"]
        }
    },
    "include": [
        "src/**/*.d.ts",
        "src/**/*.ts",
        "src/**/*.js",
        "src/**/*.svelte",
        "svelte.config.js",
        "vite.config.ts"
    ]
}
